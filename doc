# --------------------------------------------------
# HEALTH ASSISTANT
# --------------------------------------------------

st.subheader("🤖 MediNexa AI Health Assistant")

question = st.text_input(
    "Ask a question about your report"
)

if question:

    q = question.lower()

    if "doctor" in q or "specialist" in q:

        st.info(
            "Recommended specialists are displayed above."
        )

    elif "thyroid" in q or "tsh" in q:

        if "TSH" in report_data:

            st.info(
                f"TSH value is {report_data['TSH']}. "
                f"A high TSH may indicate thyroid dysfunction."
            )

    elif "ldl" in q:

        if "LDL" in report_data:

            st.info(
                f"LDL value is {report_data['LDL']}."
            )

    elif "hba1c" in q:

        if "HbA1c" in report_data:

            st.info(
                f"HbA1c value is {report_data['HbA1c']}."
            )

    elif "abnormal" in q:

        for item in abnormalities:

            st.warning(
                f"{item['parameter']} "
                f"{item['status']}"
            )

    elif "health score" in q:

        st.info(
            f"Health Score: {score}/100"
        )

    else:

        st.info(
            "I can answer questions about specialists, thyroid, LDL, HbA1c, abnormalities and health score."
        )
