# Specialists

specialists = recommend_specialists(
    abnormalities
)

st.subheader("👨‍⚕️ Recommended Specialists")

if specialists:

    for specialist in specialists:

        st.info(specialist)

        query = f"{specialist} in {city}"

        google_link = (
            "https://www.google.com/search?q="
            + query.replace(" ", "+")
        )

        st.markdown(
            f"🔍 Google Search: {google_link}"
        )

        if specialist in doctor_network:

            doctor = doctor_network[
                specialist
            ]

            st.success(
                f"""
Recommended Doctor

Doctor: {doctor['doctor']}

Location: {doctor['location']}

Rating: ⭐ {doctor['rating']}
"""
            )

            if st.button(
                f"Book Appointment - {doctor['doctor']}"
            ):

                st.success(
                    "✅ Appointment Request Submitted"
                )
