def get_live_doctors(specialist, city):

    results = []

    try:

        search_query = f"{specialist} {city}"

        response = requests.get(
            "https://html.duckduckgo.com/html/",
            params={"q": search_query},
            headers={
                "User-Agent": "Mozilla/5.0"
            },
            timeout=10
        )

        soup = BeautifulSoup(
            response.text,
            "html.parser"
        )

        search_results = soup.select(".result")

        for item in search_results[:5]:

            title = item.select_one(
                ".result__title"
            )

            snippet = item.select_one(
                ".result__snippet"
            )

            results.append({

                "name":
                title.get_text(strip=True)
                if title else "Unknown",

                "details":
                snippet.get_text(strip=True)
                if snippet else "No details"

            })

    except Exception:

        pass

    return results

